# GenAI / Google Gemini (primary, free tier)
# Create a free Gemini API key at https://aistudio.google.com/apikey and add it here.
GOOGLE_API_KEY=your-google-gemini-api-key

# GenAI / Hugging Face (fallback, Qwen model)
# Create a Hugging Face access token (with Inference API permission) at
# https://huggingface.co/settings/tokens and add it here.
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional GenAI overrides
# SUMMARY_GEMINI_MODEL_ID=gemini-2.5-flash
# SUMMARY_QWEN_MODEL_ID=Qwen/Qwen3.8-27B
# SUMMARY_MAX_NEW_TOKENS=350
# SUMMARY_TEMPERATURE=0.2
# SUMMARY_REQUEST_TIMEOUT_SECONDS=30
# SUMMARY_MAX_BATCH_PROJECTS=25

# Other services
# OVERRUN_RISK_PROBABILITY_THRESHOLD=0.5
# DEFAULT_PREFERRED_MODEL=model_b
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=INFO

# ─── Auth / Security ─────────────────────────────────────────────────────────
# A secret key used to sign JWT tokens. Generate a strong random value:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated at startup (tokens become invalid on restart).
SECRET_KEY=change-me-to-a-long-random-secret

# How long access tokens stay valid (default: 7 days = 604800 seconds).
# ACCESS_TOKEN_EXPIRE_SECONDS=604800

# Path to the SQLite database file for user accounts.
# Default: <project_root>/nirmaan_auth.db
# DATABASE_URL=/path/to/nirmaan_auth.db

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL of the frontend dev server. The backend only allows requests from this origin.
# Change this if your frontend runs on a different port.
FRONTEND_URL=http://localhost:5173

